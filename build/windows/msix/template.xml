<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="picture-frame-control.exe"
        Arguments=""
        InstallLocation="C:\Program Files\dhcgn\Picture-Frame-Control">
    </Installer>
    <PackageInformation
        PackageName="Picture-Frame-Control"
        PackageDisplayName="Picture-Frame-Control"
